PORT=4000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Never ship this key in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Separate server-side Maps Platform key; restrict it to Places API (New) + Routes API.
# Store this only in Railway/API environment variables, never in mobile/.env or source control.
GOOGLE_MAPS_SERVER_API_KEY=your-restricted-server-key
