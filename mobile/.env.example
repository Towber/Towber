# Public app configuration (these values are embedded in the app bundle).
EXPO_PUBLIC_API_URL=https://your-api.up.railway.app
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps SDK keys are native build-time config values. Restrict each key
# in Google Cloud to this app's Android package/SHA-1 or iOS bundle identifier.
GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-api-key
GOOGLE_MAPS_IOS_API_KEY=your-ios-maps-api-key
